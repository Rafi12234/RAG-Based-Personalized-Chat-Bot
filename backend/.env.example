# Copy to backend/.env and fill in values locally. Never commit .env.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# URL-encode the password ONLY in the two Prisma URLs.
DATABASE_URL="mysql://docmind_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3307/docmind_ai"
SHADOW_DATABASE_URL="mysql://docmind_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3307/docmind_ai_shadow"
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=docmind_app
DATABASE_PASSWORD=REPLACE_WITH_ORIGINAL_PASSWORD
DATABASE_NAME=docmind_ai

# Must match the root docker-compose .env settings for RustFS.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=docmind-documents
S3_ACCESS_KEY=REPLACE_WITH_ROOT_ENV_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_ROOT_ENV_S3_SECRET_KEY
